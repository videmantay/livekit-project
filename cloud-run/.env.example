# Copy to .env for local development. Never commit .env.
# In production, set these on the Cloud Run service. Use Secret Manager for secrets.

# LiveKit Cloud project, used to mint room tokens. LIVEKIT_API_SECRET is a secret.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must match the agent name registered by the livekit service.
LIVEKIT_AGENT_NAME=portfolio-twin

# Firestore project that holds the invite codes.
FIREBASE_PROJECT_ID=

# Local development only. Path to a service account key kept outside this repo.
# Leave unset on Cloud Run, which uses the service's own identity.
GOOGLE_APPLICATION_CREDENTIALS=

# Comma-separated origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# Shown in the terms. Kept here so they stay out of the public repo.
# Changing these changes the terms version, which requires fresh consent.
TERMS_LEGAL_NAME=
TERMS_CONTACT_EMAIL=

# Also shown in the terms. Firestore deletes data this many days after a session starts.
RETENTION_DAYS=90

TOKEN_TTL_SECONDS=300
MAX_SESSION_MINUTES=15
RATE_LIMIT_PER_MINUTE=10
