# Copy to .env.local for local development. Never commit it.
# Every VITE_ value is built into the public JavaScript bundle, so anyone can read it.
# Never put an API secret here. Secrets belong in cloud-run or livekit.

# Cloud Run gatekeeper URL. Leave it empty to run the visitor pages on the in-memory mock.
# The root dev.py sets it for you.
VITE_API_URL=http://localhost:8000

# Firebase web app config from the Firebase console.
# These identify the project and are not secrets. Protect data with Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Public LinkedIn profile, linked from the gate and end screens (ADR-16).
VITE_LINKEDIN_URL=

# Lee's personal YouTube channel, linked from the landing page. Leave empty to hide the link.
VITE_YOUTUBE_URL=

# Lee's GitHub profile, linked from the landing page. Leave empty to hide the link.
VITE_GITHUB_URL=
