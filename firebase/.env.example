# Copy to .env.local for local development. Never commit it.
# Every VITE_ value is built into the public JavaScript bundle, so anyone can read it.
# Never put an API secret here. Secrets belong in cloud-run or livekit.

# Cloud Run gatekeeper URL.
VITE_API_URL=http://localhost:8000

# Firebase web app config from the Firebase console.
# These identify the project and are not secrets. Protect data with Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
