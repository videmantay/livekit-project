# Copy to .env for local development. Never commit .env.
# In production, store these as LiveKit Cloud agent secrets.

# LiveKit Cloud project. LIVEKIT_API_SECRET is a secret.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must match LIVEKIT_AGENT_NAME in the cloud-run service.
LIVEKIT_AGENT_NAME=portfolio-twin

# Tavus avatar. TAVUS_API_KEY is a secret.
# The plugin also accepts the older names TAVUS_REPLICA_ID and TAVUS_PERSONA_ID.
TAVUS_API_KEY=
TAVUS_FACE_ID=
TAVUS_PAL_ID=

# ElevenLabs voice and speech-to-text. ELEVEN_API_KEY is a secret.
ELEVEN_API_KEY=
ELEVENLABS_VOICE_ID=

# Gemini. GOOGLE_API_KEY is a secret.
GOOGLE_API_KEY=
