# Copy to .env for local development. Never commit .env.
# In production, set these on the Cloud Run service. Use Secret Manager for secrets.

# LiveKit Cloud project, used to mint room tokens. LIVEKIT_API_SECRET is a secret.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must match the agent name registered by the livekit service.
LIVEKIT_AGENT_NAME=portfolio-twin

# Firestore project that holds the invite codes.
FIREBASE_PROJECT_ID=

# Local development only. Path to a service account key kept outside this repo.
# Leave unset on Cloud Run, which uses the service's own identity.
GOOGLE_APPLICATION_CREDENTIALS=

# Comma-separated origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# The owner's display name, used in the terms and the summary prompt (ADR-23).
OWNER_NAME=

# Shown in the terms. Kept here so they stay out of the public repo.
# Changing these changes the terms version, which requires fresh consent.
TERMS_LEGAL_NAME=
TERMS_CONTACT_EMAIL=

# Also shown in the terms. Firestore deletes data this many days after a session starts.
RETENTION_DAYS=90

# The one Google account allowed into admin (ADR-10).
ADMIN_EMAIL=

# Shared with the livekit agent, which signs its /internal/* requests with it. A secret.
# At least 32 characters, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_SIGNING_SECRET=

# Call summaries, through Vertex AI in FIREBASE_PROJECT_ID. No API key: the service's
# identity needs the Vertex AI User role, and locally your gcloud login or service account.
GEMINI_MODEL=gemini-3.5-flash
VERTEX_LOCATION=global

# Link-only email to ADMIN_EMAIL after each call. Leave SMTP_HOST empty to skip it.
# SMTP_PASSWORD is a secret.
ADMIN_URL=http://localhost:5173/admin
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_FROM=

TOKEN_TTL_SECONDS=300
MAX_SESSION_MINUTES=6
RATE_LIMIT_PER_MINUTE=10
